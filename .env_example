# Copy to .env (never commit .env).

# Runware key: pays for the frozen learner (and the HealthBench grader) during `stbench eval`.
RUNWARE_API_KEY=

# Only needed if the training dataset on Hugging Face is gated.
HF_TOKEN=

# GPT-6 Astra curator; the frozen learner and graders continue using Runware.
OPENAI_API_KEY=
# Optional OpenAI-compatible Responses endpoint for the curator ONLY.
# AUTORESEARCH_OPENAI_BASE_URL=https://api.openai.com/v1
